# Put the YouTube stream key here, never commit .env.
RTMP_URL=rtmp://a.rtmp.youtube.com/live2
STREAM_KEY=replace-with-your-stream-key

# Or leave RTMP_URL and STREAM_KEY blank and use one complete ingest URL.
# FULL_RTMP_URL=rtmps://a.rtmps.youtube.com:443/live2/replace-with-your-stream-key

WIDTH=1920
HEIGHT=1080
FPS=30
VIDEO_BITRATE=3500k
AUDIO_BITRATE=192k
RESTART_DELAY=10
